[
  {
    "case": "policy",
    "session_id": "ch05-accept-20261022-r3-policy",
    "question": "你们家的退货流程是什么？",
    "events": [
      {
        "type": "citations",
        "items": [
          {
            "number": 1,
            "chunk_id": 24839,
            "section_path": "MewHelp 古着退货政策 > 退货完整流程",
            "text": "退货分为申请、审核、寄回、入库验收和退款处理几个环节。先在「我的订单」选择商品，点击「申请售后」并填写原因、商品照片及联系方式；审核通过后，按订单售后页面确认的收件地址寄回，填写退回物流单号。仓库验收后按审核结果办理退款。申请成功、审核通过和退款到账是不同状态，不把其中某一步当作最终到账。",
            "original_url": "/kb?chunk_id=24839"
          },
          {
            "number": 2,
            "chunk_id": 22710,
            "section_path": "MewHelp 古着退货政策 > 退货申请步骤",
            "text": "打开「我的订单」，选择对应订单，点击「申请售后」，填写原因并提供商品状态照片。审核通过后按订单页面确认的地址寄回并填写物流单号。不要自行寄往未确认地址。",
            "original_url": "/kb?chunk_id=22710"
          },
          {
            "number": 3,
            "chunk_id": 22715,
            "section_path": "MewHelp 古着退货政策 > 退款路径与到账",
            "text": "核验通过后的退款按原支付路径办理。**禁止承诺：不保证具体到账日期、天数或几个工作日到账。** 实际到账取决于支付机构处理进度；发起退款、审核、仓库验收和到账不是同一个时间点。",
            "original_url": "/kb?chunk_id=22715"
          },
          {
            "number": 4,
            "chunk_id": 24844,
            "section_path": "MewHelp 古着退货政策 > 部分商品退货",
            "text": "同一订单只退部分商品时，在售后申请中准确选择商品和数量，保留要退商品的照片与寄件凭证。退款按实际支付、相关优惠和运费规则及审核结果处理，具体金额以订单页面核算为准；不按商品划线原价直接相加，也不擅自保证仍满足原包邮或满减条件。",
            "original_url": "/kb?chunk_id=24844"
          },
          {
            "number": 5,
            "chunk_id": 24841,
            "section_path": "MewHelp 古着退货政策 > 寄回前要准备什么",
            "text": "寄回前拍摄商品正反面、问题部位、吊牌配件及包装情况，保留订单和审核记录。按原订单核对件数，商品与配件一并整理。收件信息以本次已确认的售后页面为准，不直接照抄快递外箱上的原发件地址。",
            "original_url": "/kb?chunk_id=24841"
          },
          {
            "number": 6,
            "chunk_id": 22712,
            "section_path": "MewHelp 古着退货政策 > 质量问题与描述不符",
            "text": "签收后7天内联系客服，提供订单号及问题照片。核实后可协商换货、维修或退款；质量问题或发错货产生的相关运费由商家承担。是否成立由证据及售后审核决定，客服不能预先保证赔付。",
            "original_url": "/kb?chunk_id=22712"
          },
          {
            "number": 7,
            "chunk_id": 22708,
            "section_path": "MewHelp 古着退货政策 > 七天无理由的起点",
            "text": "自收到商品之日起7天内，商品保持收到时状态、不影响再次销售，可在订单中申请无理由退货。7天从签收起算，不从下单或发货起算。申请需经审核；客服不能直接承诺审批结果。",
            "original_url": "/kb?chunk_id=22708"
          },
          {
            "number": 8,
            "chunk_id": 24840,
            "section_path": "MewHelp 古着退货政策 > 申请入口找不到",
            "text": "先确认登录的是下单账户、订单号是否正确，以及该商品当前是否已进入可申请的售后状态。可以保留订单详情与页面提示截图，通过客服入口申请人工核实；不要重复下单或把账号密码发给客服。入口显示异常不代表已经批准或拒绝退货。",
            "original_url": "/kb?chunk_id=24840"
          },
          {
            "number": 9,
            "chunk_id": 24845,
            "section_path": "MewHelp 古着退货政策 > 已穿洗或改装后申请售后",
            "text": "收到后穿着使用、洗涤或自行改装会影响无理由退货的完好条件。若用户认为存在质量或描述问题，仍可提供订单、收到时与当前状态照片及处理经过，由人工核实；不能简单把任何争议都当作可无条件退货，也不把无理由条件解释成完全没有售后渠道。",
            "original_url": "/kb?chunk_id=24845"
          },
          {
            "number": 10,
            "chunk_id": 22709,
            "section_path": "MewHelp 古着退货政策 > 古着商品完好条件",
            "text": "保留收到时的吊牌、标识、包装及随附配件；不得在收到后穿着使用、洗涤、损坏或改装。下单前已披露的古着磨白、褪色、起球等应结合商品详情核对，不能把二手商品描述成全新无瑕。",
            "original_url": "/kb?chunk_id=22709"
          }
        ]
      },
