# LLM(DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-api-key
LLM_MODEL=deepseek-flash
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
LLM_TEMPERATURE=0.7
HISTORY_TOKEN_BUDGET=4000
# ch07 workflow: window and per-turn cumulative spend are separate.
MODEL_CONTEXT_WINDOW=128000
MAX_OUTPUT_TOKENS=4000
MAX_USER_INPUT_TOKENS=4000
MAX_AGENT_STEPS=8
TOOL_RESULT_MAX_TOKENS=2400
RERANK_TOP_K=10
CONTEXT_TARGET_TURNS=40
CONTEXT_STEADY_TURN_TOKENS=2000
CONTEXT_SYSTEM_RESERVE_TOKENS=2000
CONTEXT_EVIDENCE_TOKENS_PER_HIT=300
CONTEXT_SUMMARY_RESERVE_TOKENS=1000
CONTEXT_PROTOCOL_RESERVE_TOKENS=400
CONTEXT_SAFETY_RATIO=0.025
AGENT_DECISION_MAX_TOKENS=300
CONTEXT_CJK_TOKENS_PER_CHAR=1.0
# Optional hard cumulative cap; unset derives (MAX_AGENT_STEPS+6)*window.
# CONTEXT_TURN_TOKEN_BUDGET=162000
MAX_SESSIONS=1000
SHOP_NAME=MewHelp 商城
AGENT_NAME=小喵

# MySQL
DB_URL=mysql+pymysql://root:<你的密码>@127.0.0.1:3306/melhelp

# 工具
TOOL_TIMEOUT=10
FAQ_MAX_RESULTS=3

# 嵌入(SiliconFlow BGE-M3;真实 key 只写本地 .env)
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=<你的硅基流动 API Key>
EMBEDDING_MODEL=BAAI/bge-m3
# BGE-M3 固定 1024 维,不要改
EMBEDDING_DIM=1024
# SiliconFlow 单请求上限 64,项目取 32
EMBEDDING_BATCH_SIZE=32

# Milvus(本地 standalone 的 token 留空)
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
KNOWLEDGE_COLLECTION=knowledge
# 在线召回的余弦相似度阈值
KNOWLEDGE_MIN_SCORE=0.5
# 挖掘去重的余弦相似度阈值
KNOWLEDGE_DEDUP_SCORE=0.92

# 对话挖掘
MINING_BATCH_SIZE=5
MINING_MAX_CHARS=6000

# 建库与作业
KB_SOURCES_DIR=data/kb
# /api/kb 手工录入请求体上限(200 KB)
KB_MAX_MARKDOWN_BYTES=204800
JOB_LOG_DIR=log/acceptance
# make 不在 PATH 时填绝对路径
MAKE_EXE=make

# ch04：迁移并核验后显式启用，未启用时保持 ch03/dense。
KB_CORPUS_VERSION=ch03
KNOWLEDGE_STRATEGY=dense
HYBRID_COLLECTION=knowledge_hybrid_ch04_v2_final
KB_MIGRATION_MANIFEST=log/kb/ch04-v2-final-migration.json
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 留空时复用 EMBEDDING_API_KEY；真实 key 仅放本地 .env。
RERANK_API_KEY=
RERANK_MIN_SCORE=0.5
QUERY_TIMEOUT=12
RERANK_TIMEOUT=15
EMBEDDING_TIMEOUT=10
KNOWLEDGE_TOOL_TIMEOUT=90
ANSWER_TIMEOUT=45

# ch05：新编排显式启用；SQLite文件及辅助文件位于gitignored log/。
CHAT_WORKFLOW_ENABLED=false
AGENT_MAX_TOOL_CALLS=6
AGENT_TOKEN_BUDGET=12000
AGENT_TURN_TIMEOUT=90
AGENT_MAX_DECISIONS=10
WORKFLOW_CHECKPOINT_PATH=log/ch05/checkpoints.sqlite
# ch06 分类沿用主力聊天模型；可指定同一上游的独立主力型号。
# INTENT_MODEL=
INTENT_MIN_CONFIDENCE=0.7
# 以下仅为未来降级路线配置种子，ch06即使填写也不会调用小模型或升级重判。
# INTENT_SMALL_MODEL=future-small-model
# INTENT_ESCALATION_THRESHOLD=0.7
